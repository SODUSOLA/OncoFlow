# ── Server ──
NODE_ENV=development
PORT=3000
# Comma-separated allowlist. No wildcard — required in production, app refuses to boot without it
# (src/app.ts). Local dev falls back to http://localhost:5173 if unset.
CORS_ORIGIN=http://localhost:5173

# ── Database (Postgres via PgBouncer, transaction-pooling mode — ADR-0013) ──
DATABASE_URL=postgresql://oncoflow:oncoflow_dev@localhost:6432/oncoflow
# Local docker-compose only (infra/docker-compose.yml) — sets the Postgres/PgBouncer app
# password that DATABASE_URL above must match. Not read directly by the app itself.
POSTGRES_PASSWORD=oncoflow_dev

# ── Redis (permission cache — src/lib/rbac.ts, rate limiting — src/lib/rate-limit.ts) ──
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 (file storage — src/modules/documents/services/StorageService.ts, ADR-0014) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=oncoflow-uploads
# Referenced in infra/README.md's Coolify secrets table; not yet read anywhere in src —
# will matter once signed/public download URLs are built (Sprint 3/4).
R2_PUBLIC_URL=

# ── Monnify (billing/payments — src/modules/billing/services/MonnifyService.ts) ──
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Required for reserved-account creation (createReservedAccount) — was missing from this file
# even though MonnifyService.ts has read it since Sprint 2.
MONNIFY_CONTRACT_CODE=

# ── Video/meetings (Sprint 3 — messaging module; meeting/transcript tables exist, no
# service wired yet). Listed here because infra/README.md's Coolify secrets table already
# expects it (Whereby/Daily API key) — nothing in src/ reads it yet.
VIDEO_SDK_KEY=

# ── JWT ──
# NOT currently used anywhere in src/ — auth is opaque HttpOnly session cookies
# (src/lib/session-cookie.ts, src/lib/request-context.ts), deliberately not JWTs
# (sprint2-hardening-checklist.md: "JWTs: do not add them; opaque server sessions are
# enough"). `jsonwebtoken` is still a package.json dependency and this var is still wired
# through infra/docker-compose.yml and infra/README.md's Coolify table — kept here so all
# three stay consistent, but treat it as unused/legacy until something actually reads it.
JWT_SECRET=change-me-in-production   