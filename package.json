{
  "name": "oncoflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck -w apps/api",
    "lint": "npm run lint -w apps/api",
    "format": "npm run format -w apps/api",
    "format:fix": "npm run format:fix -w apps/api",
    "test": "npm run test -w apps/api",
    "test:watch": "npm run test:watch -w apps/api",
    "test:coverage": "npm run test:coverage -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "depcruise": "npm run depcruise -w apps/api",
    "ci": "npm run typecheck && npm run lint -w apps/api && npm run depcruise && npm run test"
  }
}
